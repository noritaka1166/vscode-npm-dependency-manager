{
  "name": "npm-dependency-manager",
  "displayName": "npm Dependency Manager: Audit & SBOM",
  "description": "Manage npm dependencies in VS Code: run npm audit, review vulnerabilities, updates, licenses, and package-lock.json, then export CycloneDX or SPDX SBOMs and CSV reports.",
  "version": "0.0.9",
  "publisher": "noritaka1166",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#102333",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noritaka1166/vscode-npm-dependency-manager.git"
  },
  "bugs": {
    "url": "https://github.com/noritaka1166/vscode-npm-dependency-manager/issues"
  },
  "homepage": "https://github.com/noritaka1166/vscode-npm-dependency-manager#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "npm",
    "npm dependencies",
    "dependency manager",
    "package.json",
    "package-lock",
    "package lock",
    "npm audit",
    "dependency updates",
    "vulnerability",
    "vulnerability scanner",
    "vulnerability management",
    "software supply chain",
    "security",
    "CVE",
    "OSV",
    "CISA KEV",
    "KEV",
    "EPSS",
    "SSVC",
    "license compliance",
    "SBOM",
    "CycloneDX",
    "SPDX",
    "software bill of materials",
    "CSV export",
    "Node.js",
    "JavaScript",
    "TypeScript",
    "npm package manager",
    "dependency audit"
  ],
  "qna": false,
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js && node --check lib/security.js && node --check lib/repository.js && node --check lib/package-manager.js && node --check lib/dependency-update.js && node --check lib/sbom.js && node --check lib/dependency-report.js && node --check media/main.js",
    "test": "node --test",
    "vscode:prepublish": "npm run check",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspaceNpmSidebar",
          "title": "npm Packages",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "workspaceNpmSidebar": [
        {
          "id": "workspaceNpmSidebar.dependenciesView",
          "name": "Dependencies",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceNpmSidebar.show",
        "title": "npm Packages: Show Dashboard"
      },
      {
        "command": "workspaceNpmSidebar.refresh",
        "title": "npm Packages: Refresh"
      },
      {
        "command": "workspaceNpmSidebar.exportSbom",
        "title": "npm Packages: Export SBOM"
      },
      {
        "command": "workspaceNpmSidebar.exportCsv",
        "title": "npm Packages: Export Dependency Report CSV"
      },
      {
        "command": "workspaceNpmSidebar.openPackage",
        "title": "npm Packages: Open Package"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "markdown-it": "^15.0.2",
    "semver": "^7.8.5"
  }
}
